{"line_id": "l13", "lang": "en", "speaker": "aditya", "model": "eleven_v4", "voice_id": "zCXXiWzuZO7d9fERssmF", "text": "[calm] Bureau, Bhaiya in the car, Mausi on the phone, bride gone by morning.", "file": "content/series1/episodes/s1e01/voice/en/l13.mp3", "generation_id": "UcJYMEC5ebdcy6ZjUm2S", "flow_id": "d88gHf3WQmPw3Y2BMqc6", "credits": 76, "duration_s": 5.84, "mean_db": -19.8, "max_db": -3.6, "take": 1, "status": "ok", "error": null}
{"line_id": "l14", "lang": "en", "speaker": "aditya", "model": "eleven_v4", "voice_id": "zCXXiWzuZO7d9fERssmF", "text": "[quietly] It took me fourteen months to become your party.", "file": "content/series1/episodes/s1e01/voice/en/l14.mp3", "generation_id": "c2ririS03tOGdxyUYtq6", "flow_id": "d88gHf3WQmPw3Y2BMqc6", "credits": 58, "duration_s": 2.8, "mean_db": -24.9, "max_db": -7.6, "take": 1, "status": "ok", "error": null}
{"line_id": "l15", "lang": "en", "speaker": "kiran", "model": "eleven_v4", "voice_id": "FtcqBL9uKtROtyotPjvE", "text": "[calm] This is my last wedding. Mausi has eighteen lakh of mine.", "file": "content/series1/episodes/s1e01/voice/en/l15.mp3", "generation_id": "1K2Csgn8NrTuJtUV7Mzs", "flow_id": "d88gHf3WQmPw3Y2BMqc6", "credits": 64, "duration_s": 4.32, "mean_db": -20.8, "max_db": -5.0, "take": 1, "status": "ok", "error": null}
