{"line_id": "l20", "lang": "en", "speaker": "aditya", "model": "eleven_v4", "voice_id": "zCXXiWzuZO7d9fERssmF", "text": "[hesitant] My little brother, Mohit. Mausi arranged his wedding.", "file": "content/series1/episodes/s1e01/voice/en/l20.mp3", "generation_id": "6XhHTHeLVIuUGYv4dCoC", "flow_id": "d88gHf3WQmPw3Y2BMqc6", "credits": 64, "duration_s": 4.56, "mean_db": -18.7, "max_db": -3.7, "take": 1, "status": "ok", "error": null}
