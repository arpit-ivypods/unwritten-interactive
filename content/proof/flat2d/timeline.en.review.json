  },
  {
   "startMs": 9100,
   "endMs": 10533,
   "text": "Just..."
  },
  {
   "startMs": 10900,
   "endMs": 12433,
   "text": "one laddoo is kept there."
  },
  {
   "startMs": 13033,
   "endMs": 13833,
   "text": "Laddoo?"
  },
  {
   "startMs": 14100,
   "endMs": 15366,
   "text": "It's motichoor, ma—"
  },
  {
   "startMs": 15433,
   "endMs": 16233,
   "text": "Bablu!"
  },
  {
   "startMs": 16433,
   "endMs": 18933,
   "text": "That cash has to be in\ncourt at nine a.m.!"
  },
  {
   "startMs": 19466,
   "endMs": 20933,
   "text": "The lock isn't broken..."
  },
  {
   "startMs": 21633,
   "endMs": 23233,
   "text": "it was opened with a key."
  },
  {
   "startMs": 24200,
   "endMs": 27633,
   "text": "There are only two keys,\nmadam. One is with you..."
  },
  {
   "startMs": 27800,
   "endMs": 29000,
   "text": "And the other..."
  },
  {
   "startMs": 29300,
   "endMs": 30533,
   "text": "is with Bada Sahab."
