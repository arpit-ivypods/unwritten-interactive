  },
  {
   "startMs": 2150,
   "endMs": 6317,
   "text": "Police अफ़सर बनकर थाना चलाने के जुर्म में,\nआप under arrest हैं।"
  },
  {
   "startMs": 6683,
   "endMs": 8083,
   "text": "जी, madam।"
  },
  {
   "startMs": 8350,
   "endMs": 10917,
   "text": "बस... cap रहने दीजिए।"
  },
  {
   "startMs": 11283,
   "endMs": 12450,
   "text": "'एक revolver,"
  },
  {
   "startMs": 12517,
   "endMs": 13317,
   "text": "लकड़ी की।"
  },
  {
   "startMs": 13617,
   "endMs": 14617,
   "text": "मुलज़िम से बरामद।'"
  },
  {
   "startMs": 14983,
   "endMs": 16850,
   "text": "तारीख़ डाल दीजिए, madam।"
  },
  {
   "startMs": 20717,
   "endMs": 22650,
   "text": "दो साल में पहला मुलज़िम।"
  },
  {
   "startMs": 23417,
   "endMs": 25983,
   "text": "ताला तक भूल गया था कि खुलते कैसे हैं।"
  },
  {
   "startMs": 29850,
   "endMs": 30983,
   "text": "बारह।"
  },
  {
   "startMs": 31050,
   "endMs": 32717,
   "text": "भैयाजी इंतज़ार कर रहे होंगे।"
  },
  {
   "startMs": 34917,
   "endMs": 35750,
   "text": "रोकिए।"
  },
  {
   "startMs": 35817,
   "endMs": 36617,
   "text": "काग़ज़ दिखाइए।"
  },
  {
   "startMs": 36950,
   "endMs": 37850,
   "text": "आठ सौ बोरी।"
  },
  {
   "startMs": 38383,
   "endMs": 39417,
   "text": "और sign..."
  },
  {
   "startMs": 39483,
   "endMs": 41350,
   "text": "SHO त्रिपाठी के।"
  },
  {
   "startMs": 41850,
   "endMs": 42817,
   "text": "मोहर समेत।"
  },
  {
   "startMs": 43183,
   "endMs": 44450,
   "text": "काग़ज़ पूरे हैं।"
  },
  {
   "startMs": 47050,
   "endMs": 49150,
   "text": "बारह बजकर दस मिनट।"
  },
  {
   "startMs": 49217,
   "endMs": 50017,
   "text": "आठ सौ बोरी।"
  },
  {
   "startMs": 50583,
   "endMs": 51450,
   "text": "मैंने जाने दिया।"
  },
  {
   "startMs": 51817,
   "endMs": 54317,
   "text": "Truck गया, madam?"
  },
  {
   "startMs": 54683,
   "endMs": 55483,
   "text": "गया।"
  },
  {
   "startMs": 55717,
   "endMs": 57483,
   "text": "SHO साहब के sign पर।"
  },
  {
   "startMs": 57850,
   "endMs": 61283,
   "text": "मोहर पहले से SHO साहब की थी, madam?"
  },
  {
   "startMs": 61550,
   "endMs": 63783,
   "text": "तो मेरी मोहर की ज़रूरत ही नहीं थी।"
  },
  {
   "startMs": 64150,
   "endMs": 67050,
   "text": "और फिर भी भैयाजी ने आपको अकेले बुलाया।"
  },
  {
   "startMs": 67350,
   "endMs": 70150,
   "text": "मतलब बुलावा मोहर के लिए नहीं था।"
  },
  {
   "startMs": 70217,
   "endMs": 71083,
   "text": "आपके लिए था।"
  },
  {
   "startMs": 73783,
   "endMs": 75517,
   "text": "माल गया, madam।"
  },
  {
   "startMs": 75583,
   "endMs": 76617,
   "text": "Complaint नहीं गईं।"
  },
  {
   "startMs": 77117,
   "endMs": 81150,
   "text": "पर मेरी files नक़ली थाने का काग़ज़ हैं।\nअसली register में चढ़ाइए।"
  },
  {
   "startMs": 81417,
   "endMs": 84750,
   "text": "Complaint वहीं चढ़कर\nFIR बनती है, madam।"
  },
  {
   "startMs": 85117,
   "endMs": 88283,
   "text": "सुबह दस बजे इस थाने में microphone होंगे।"
  },
  {
   "startMs": 88650,
   "endMs": 92083,
   "text": "Press के सामने रखा\nregister कोई दबा नहीं सकता।"
  },
  {
